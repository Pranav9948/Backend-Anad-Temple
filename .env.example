NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Development/test database (Neon)
DATABASE_URL=

# Production only (Supabase). Prefer direct URL for migrations/DDL.
# App runtime can use the pooled DATABASE_URL from ECS.
# DATABASE_DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
TEMPLE_ADMIN_EMAIL=
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000

ADMIN_SEED_MOBILE=
ADMIN_SEED_NAME=

# Optional: force Prisma CLI env selection (development | production | test)
# PRISMA_ENV=development
