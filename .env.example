NODE_ENV=development
PORT=7777
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:2026@localhost:5432/dev_temple_booking
JWT_ACCESS_SECRET=change-me-min-10-chars
JWT_REFRESH_SECRET=change-me-min-10-chars
FRONTEND_URL=http://localhost:3000

# Razorpay (Stage 7) — use test keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# WhatsApp (Stage 8) — Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=META
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
TEMPLE_ADMIN_WHATSAPP_NUMBER=919020602727
WHATSAPP_RETRY_MAX_ATTEMPTS=3
WHATSAPP_RETRY_DELAY_MS=1000

# Seed (Stage 3) — used by `pnpm run db:seed`
ADMIN_SEED_MOBILE=9020602727
ADMIN_SEED_NAME=Temple Admin