    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "dotenv-cli": "^8.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
