// Temple Vinayaka Chathurthi Booking — Stage 3 domain schema
// Brand-new schema for the temple domain (not reused from SaaS).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Language selected by the devotee for the booking form / communication.
enum Language {
  KANNADA
  ENGLISH
  TELUGU
  TAMIL
  HINDI
  MALAYALAM
}

/// Role for temple admin accounts.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/// Lifecycle of a booking from checkout through confirmation or cancellation.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

/// Whether the devotee chose to pay online now or book and pay later.
enum BookingPaymentOption {
  PAY_ONLINE
  PAY_LATER
}

/// Payment lifecycle tracked by temple admin and/or payment gateway.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WAIVED
}

/// How a booking was paid (online gateway or offline admin collection).
enum PaymentMethod {
  RAZORPAY
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

/// OTP verification lifecycle for mobile-number flows.
enum OTPStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

/// Why an OTP was issued.
enum OTPPurpose {
  BOOKING_VERIFICATION
  ADMIN_LOGIN
}

/// The 27 lunar mansions used for Archana nakshatra selection.
enum Nakshatra {
  ASHWINI
  BHARANI
  KRITTIKA
  ROHINI
  MRIGASHIRA
  ARDRA
  PUNARVASU
  PUSHYA
  ASHLESHA
  MAGHA
  PURVA_PHALGUNI
  UTTARA_PHALGUNI
  HASTA
  CHITRA
  SWATI
  VISHAKHA
  ANURADHA
  JYESHTHA
  MULA
  PURVA_ASHADHA
  UTTARA_ASHADHA
  SHRAVANA
  DHANISHTA
  SHATABHISHA
  PURVA_BHADRAPADA
  UTTARA_BHADRAPADA
  REVATI
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Temple staff who manage bookings and payments. Independent of bookings.
model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admins")
}

/// A devotee booking for Vinayaka Chathurthi Archana.
model Booking {
  id              String               @id @default(uuid()) @db.Uuid
  referenceNumber String               @unique @map("reference_number") @db.VarChar(32)
  language        Language
  devoteeName     String               @map("devotee_name") @db.VarChar(255)
  mobileNumber    String               @map("mobile_number") @db.VarChar(15)
  status          BookingStatus        @default(PENDING_PAYMENT)
  paymentOption   BookingPaymentOption @map("payment_option")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  members BookingMember[]
  payment Payment?

  @@index([mobileNumber])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("bookings")
}

/// An Archana member attached to a booking (name + nakshatra).
model BookingMember {
  id         String    @id @default(uuid()) @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  memberName String    @map("member_name") @db.VarChar(255)
  nakshatra  Nakshatra
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_members")
}

/// Optional payment record — at most one per booking (pay-online or admin-added later).
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @unique @map("booking_id") @db.Uuid
  amountPaise      Int           @map("amount_paise")
  currency         String        @default("INR") @db.Char(3)
  status           PaymentStatus @default(PENDING)
  method           PaymentMethod
  gatewayOrderId   String?       @map("gateway_order_id") @db.VarChar(255)
  gatewayPaymentId String?       @map("gateway_payment_id") @db.VarChar(255)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  adminNotes       String?       @map("admin_notes") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

/// One-time password records for mobile verification. Independent of bookings.
model OTP {
  id           String     @id @default(uuid()) @db.Uuid
  mobileNumber String     @map("mobile_number") @db.VarChar(15)
  otpHash      String     @map("otp_hash") @db.VarChar(255)
  purpose      OTPPurpose
  status       OTPStatus  @default(PENDING)
  attemptCount Int        @default(0) @map("attempt_count")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([mobileNumber, status])
  @@index([expiresAt])
  @@map("otps")
}
